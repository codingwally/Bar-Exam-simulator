{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duediligence-constitutional-exam",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "EXAM_DB",
      "database_name": "duediligence-constitutional-exam",
      "database_id": "REPLACE_WITH_VERIFIED_D1_ID"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "ADMIN_EMAILS": "wallyesteban1993@gmail.com",
    "EXAMINER_EMAILS": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "EMAIL_DELIVERY_ENABLED": "false"
  },
  "observability": { "enabled": false }
}
