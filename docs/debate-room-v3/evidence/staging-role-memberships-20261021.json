  "query": "BEGIN TRANSACTION READ ONLY;\nSET LOCAL statement_timeout='15s';\nWITH RECURSIVE relevant(roleid) AS (\n  SELECT oid FROM pg_roles WHERE rolname IN ('postgres','service_role','anon','authenticated','supabase_admin','supabase_auth_admin','dashboard_user','pg_database_owner')\n  UNION\n  SELECT m.roleid FROM pg_auth_members m JOIN relevant r ON m.member=r.roleid\n)\nSELECT clock_timestamp() AS captured_at,\n       current_database() AS database_name,\n       current_user AS current_user_name,\n       (SELECT jsonb_agg(jsonb_build_object('role',r.rolname,'superuser',r.rolsuper,'inherit',r.rolinherit,'createRole',r.rolcreaterole,'createDatabase',r.rolcreatedb,'canLogin',r.rolcanlogin,'replication',r.rolreplication,'bypassRls',r.rolbypassrls,'connectionLimit',r.rolconnlimit) ORDER BY r.rolname) FROM pg_roles r JOIN relevant v ON v.roleid=r.oid) AS relevant_roles,\n       (SELECT coalesce(jsonb_agg(jsonb_build_object('member',member_role.rolname,'grantedRole',parent_role.rolname,'grantor',grantor_role.rolname,'adminOption',m.admin_option,'inheritOption',m.inherit_option,'setOption',m.set_option) ORDER BY member_role.rolname,parent_role.rolname,grantor_role.rolname),'[]'::jsonb) FROM pg_auth_members m JOIN relevant v ON v.roleid=m.member JOIN pg_roles member_role ON member_role.oid=m.member JOIN pg_roles parent_role ON parent_role.oid=m.roleid JOIN pg_roles grantor_role ON grantor_role.oid=m.grantor) AS relevant_memberships;\nCOMMIT;",
