    "examinable_cutoff": "2025-06-30",
    "questions_per_subject": 20,
    "allocation_rule": "Every subject must match its top-level targets exactly. The headings follow the official 2026 Bar syllabus structure; the numeric targets are Forecast coverage guardrails, not official Supreme Court question weights.",
    "leb_curriculum_authority": "Legal Education Board Memorandum Order No. 24, Series of 2021",
    "leb_curriculum_url": "https://leb.gov.ph/wp-content/uploads/2021/07/LEBMO-No.-24.pdf",
    "leb_curriculum_table_confirmation_url": "https://leb.gov.ph/wp-content/uploads/2023/06/MEMORANDUM-No.-2023-013-1.pdf",
    "leb_prior_definition": "An independent within-subject course-exposure prior equal to the published credit units of the directly mapped LEB model-curriculum course or courses. It is never calculated from target_questions. When several official syllabus headings fall within one LEB course, they honestly share that course exposure rather than receiving invented sub-course weights. It is pedagogical evidence, not a probability of appearing in the Bar.",
    "syllabus_centrality_definition": "Every listed official top-level 2026 syllabus heading receives a value of 1 while an allocated slot remains open. No forecast quota or past-question count is reused in this component; exact target_questions separately enforce breadth and concentration limits."
  },
  "safeguards": {
    "exact_subject_total": 20,
    "exact_unit_targets_required": true,
    "one_controlling_doctrine_per_question": true,
    "maximum_questions_per_controlling_doctrine_per_subject": 1,
    "maximum_questions_per_primary_authority_per_subject": 1,
    "cross_labeled_question_counting_rule": "Count a question against every applicable concentration cap, but assign it to exactly one primary syllabus unit. A question may not evade a cap by using a different primary label.",
    "political_election_context_cap": 1,
    "political_election_context_definition": "Any question centered on elections, candidacy, suffrage, COMELEC, electoral tribunals, election protests, election offenses, or election remedies counts toward the Election Law cap even when another constitutional doctrine is the primary issue.",
    "unallocated_unit_rule": "Do not publish a question outside the listed allocation. A proposed exception requires a versioned allocation change, written source-backed justification, and rerun of all distribution and parity validators."
  },
